# ALIYSS' gitignore
# Can't share everything :')

# Ignore all files
/*
/*/

# Except the following

# General
!/.gitignore
!/README.md
!/README.org

# Images
!/images/

# Tridactyl
!/chawan/

# Emacs
!/emacs/
/emacs/*
/emacs/*/

!/emacs/init.el
!/emacs/early-init.el
!/emacs/config.org
!/emacs/eshell/
!/emacs/eshell/*
!/emacs/eshell/*/
!/emacs/images/
!/emacs/images/*
!/emacs/images/*/

# Flake
!/flake/
/flake/*/.env
# Nix build outputs — not tracked
/flake/result
/flake/result-*
/flake/build/

# Foot
!/foot/
# foot.ini is generated by home-manager (flake/home-manager/apps/foot/default.nix)
# via xdg.configFile — do not track the nix-store symlink.
/foot/foot.ini

# Hyprland
!/hypr/
/hypr/hyprland.conf
# Generated by home-manager (wayland.windowManager.hyprland + apps/hyprlock.nix)
/hypr/hyprland.lua
/hypr/.luarc.json
/hypr/hyprlock.conf
/hypr/device_settings.conf

# Niri
!/niri/

# Tridactyl

# Keymappings
!/wlr-which-key/
/wlr-which-key/config.yaml
!/xkb/

# Opencode
!/opencode/
/opencode/.gitignore
/opencode/package.json
/opencode/package-lock.json
/opencode/bun.lock
!/opencode/opencode.jsonc
!/opencode/plugins/
!/opencode/themes/
# catppuccin.json is generated by home-manager (flake/home-manager/themes/default.nix)
/opencode/themes/catppuccin.json
!/opencode/tui.json

# Phone Management
!/aliyss-phone/
/aliyss-phone/colors.properties
/aliyss-phone/config.fish

# YouTube Music
# Tracked config lives in nix (flake/home-manager/apps/youtube-music.nix).
# The app's live config.json (window state, url) is per-PC; fully ignored.
